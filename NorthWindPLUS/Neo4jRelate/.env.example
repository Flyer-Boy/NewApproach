# Copy to .env (never commit .env) and fill in.
ANTHROPIC_API_KEY=
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# full   = all six simulation loops run (run_loops_full.bat); the agent answers questions, runs what-ifs and changes
#          the approval limits. The default.
# agents = PO creation and resubmission are done by a Procurement Assistant with the agent (run_loops_agents.bat).
SIMULATION_MODE=full

# Optional, Windows run_loops_*.bat: the Python that runs the loops (needs requirements.txt installed), e.g.
# PYTHON=C:\Users\you\anaconda3\python.exe    -- no quotes. Default: the first "python" on PATH.

# Optional, web UI (run_ui.bat):
# DEMAND_WINDOW_DAYS=7     recent demand is measured over this many days
# DEMAND_COVER_DAYS=7      suggest the quantity that covers this many days of that demand
# DRAFT_MODEL=claude-sonnet-5-5  the model for justification drafts (default: the agent's model; needs ANTHROPIC_API_KEY)

# Optional embeddings:
# EMBEDDINGS=voyage-4-nano      (pip install -r requirements-embeddings.txt)
# EMBEDDINGS=voyage-api         (pip install voyageai)
# VOYAGE_API_KEY=
